# =====================================================
# Battle XI · Variables de entorno
# Copiá este archivo a .env y completá los valores
# =====================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Database (Postgres) ----
DATABASE_URL=postgresql://user:password@host:5432/battlexi

# ---- Auth (sesiones y PIN) ----
# Generá uno con: openssl rand -base64 32
AUTH_SECRET=

# ---- Storage de imágenes (MinIO / S3) ----
# S3_ENDPOINT es el endpoint interno que usa el servidor para subir.
# S3_PUBLIC_URL es la base pública desde la que el navegador lee las fotos.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=battlexi
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=http://localhost:9000/battlexi

# ---- Replicate (IA generativa, todavía no conectada) ----
# Sacá tu token en https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# ---- Telemetría (opcional) ----
NEXT_TELEMETRY_DISABLED=1
