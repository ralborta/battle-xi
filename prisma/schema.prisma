datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Position {
  POR
  DEF
  MC
  DC
  DEL
  EXT
}

enum Rarity {
  common
  pro
  rare
  elite
  champion
  legend
}

enum ScanStatus {
  pending
  confirmed
  discarded
}

enum BattleStatus {
  active
  finished
}

enum BattleResult {
  win
  loss
  draw
}

/// De dónde salió la carta del chico.
enum CardSource {
  scan
  pack
  starter
}

enum SquadMode {
  futbol5
}

enum TeamMatchStatus {
  active
  finished
}

/// Estilo táctico del equipo en un partido de Fútbol 5.
enum TeamStyle {
  ataque
  equilibrio
  defensa
}

model User {
  id String @id @default(cuid())

  /// Apodo tal como lo escribió el chico, para mostrar en pantalla.
  nickname String
  /// Versión normalizada en minúsculas: es la que garantiza unicidad y sirve para el login.
  nicknameKey String @unique
  parentEmail String
  pinHash     String

  gems     Int @default(50)
  xp       Int @default(0)
  trophies Int @default(0)
  wins     Int @default(0)
  losses   Int @default(0)
  draws    Int @default(0)
  streak   Int @default(0)

  /// La energía no se descuenta con un cron: se recalcula al leerla a partir de
  /// cuándo fue la última vez que la tocamos.
  energy          Int      @default(20)
  energyUpdatedAt DateTime @default(now())

  cards             Card[]
  scans             Scan[]
  battles           Battle[] @relation("BattleUser")
  battlesAsOpponent Battle[] @relation("BattleOpponentUser")
  squads            Squad[]
  teamMatches       TeamMatch[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([parentEmail])
}

/// Ficha del catálogo propio (nombres + avatar). Las stats Battle XI viven acá, no en la API.
model PlayerTemplate {
  id String @id @default(cuid())

  slug        String   @unique
  playerName  String
  countryCode String
  countryFlag String
  position    Position
  /// Posiciones compatibles, ej. ["EXT","MC"].
  compatible  Json     @default("[]")
  rarity      Rarity
  rating      Int
  ability     String   @default("none")
  imageUrl    String   @default("/avatars/player-default.svg")

  vel Int
  tir Int
  pas Int
  reg Int
  def Int
  fis Int

  published Boolean @default(true)
  cards     Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
  @@index([countryCode])
}

model Scan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageKey String
  imageUrl String
  /// Texto crudo que devolvió el OCR, para poder mejorar el reconocimiento más adelante.
  ocrText      String?
  detectedName String?
  status       ScanStatus @default(pending)

  card Card?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Card {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId String? @unique
  scan   Scan?   @relation(fields: [scanId], references: [id], onDelete: SetNull)

  source     CardSource @default(scan)
  templateId String?
  template   PlayerTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  playerName  String
  position    Position
  rarity      Rarity
  rating      Int
  level       Int     @default(1)
  xp          Int     @default(0)
  countryFlag String  @default("🇦🇷")
  imageUrl    String?
  ability     String  @default("none")

  vel Int
  tir Int
  pas Int
  reg Int
  def Int
  fis Int

  battles           Battle[] @relation("BattleUserCard")
  battlesAsOpponent Battle[] @relation("BattleOpponentCard")
  squadSlots        SquadSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, source])
  @@index([templateId])
}

/// Plantel guardado. Por ahora solo Fútbol 5; el XI llega después.
model Squad {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode   SquadMode @default(futbol5)
  style  TeamStyle @default(equilibrio)
  /// Slot del capitán: POR | DEF | MC1 | MC2 | DEL
  captainSlot String?

  slots SquadSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mode])
}

model SquadSlot {
  id     String @id @default(cuid())
  squadId String
  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  /// POR | DEF | MC1 | MC2 | DEL
  slotKey String
  cardId  String?
  card    Card?  @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([squadId, slotKey])
  @@index([cardId])
}

/// Partido de Fútbol 5 (modo equipo). Acumula puntos; torneos vienen después.
model TeamMatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status TeamMatchStatus @default(active)
  result BattleResult?

  styleUser TeamStyle @default(equilibrio)
  styleBot  TeamStyle @default(equilibrio)

  impulseLeft   Int @default(100)
  scoreUser     Int @default(0)
  scoreOpponent Int @default(0)
  /// Momento actual: 0..3 (recuperación, construcción, definición, decisivo).
  momentIndex Int @default(0)

  /// Snapshot del once propio y del bot + historial de momentos.
  lineupUser Json
  lineupBot  Json
  moments    Json @default("[]")
  seed       String

  gemsEarned    Int @default(0)
  xpEarned      Int @default(0)
  trophiesDelta Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, status])
}

model Battle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("BattleUser", fields: [userId], references: [id], onDelete: Cascade)
  cardId String
  card   Card   @relation("BattleUserCard", fields: [cardId], references: [id], onDelete: Cascade)

  opponentUserId String?
  opponentUser   User?   @relation("BattleOpponentUser", fields: [opponentUserId], references: [id], onDelete: SetNull)
  opponentCardId String?
  opponentCard   Card?   @relation("BattleOpponentCard", fields: [opponentCardId], references: [id], onDelete: SetNull)

  /// Copiamos la carta rival al empezar: si su dueño la mejora a mitad del duelo,
  /// la batalla en curso no cambia.
  opponentNickname String
  opponentName     String
  opponentPosition Position
  opponentRarity   Rarity
  opponentRating   Int
  opponentLevel    Int
  opponentFlag     String
  opponentImageUrl String?
  opponentVel      Int
  opponentTir      Int
  opponentPas      Int
  opponentReg      Int
  opponentDef      Int
  opponentFis      Int
  /// Cuando todavía no hay cartas de otros chicos, el rival lo arma el sistema.
  isBot Boolean @default(false)

  status        BattleStatus  @default(active)
  result        BattleResult?
  scoreUser     Int           @default(0)
  scoreOpponent Int           @default(0)
  /// [{ stat, userValue, opponentValue, winner }] en el orden en que se jugaron.
  rounds Json @default("[]")
  /// Semilla del empuje aleatorio de cada ronda: la guarda el server para que el
  /// resultado no dependa del navegador.
  seed String

  gemsEarned    Int @default(0)
  xpEarned      Int @default(0)
  trophiesDelta Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, status])
}
